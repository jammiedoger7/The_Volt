# The Volt - Environment Variables
# Copy this file to .env and fill in your real keys
# NEVER commit .env to version control

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key

# OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-weather-key

# ClipDrop Background Removal (https://clipdrop.co/apis)
BG_REMOVAL_API_KEY=your-clipdrop-key

# RevenueCat (https://app.revenuecat.com → Project Settings)
REVENUECAT_API_KEY=your-revenuecat-key
